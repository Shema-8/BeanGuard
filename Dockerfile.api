

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TF_CPP_MIN_LOG_LEVEL=2

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install -r requirements.txt

# Copy application source code
COPY src ./src
COPY api ./api
COPY models ./models

# Copy original training and testing datasets
COPY data/train ./data/train
COPY data/test ./data/test

# Verify that the training and testing images exist
RUN echo "Checking training dataset..." && \
    find /app/data/train -type f | head -10 && \
    TRAIN_COUNT=$(find /app/data/train -type f | wc -l) && \
    echo "Training files found: $TRAIN_COUNT" && \
    test "$TRAIN_COUNT" -gt 0 && \
    echo "Checking testing dataset..." && \
    TEST_COUNT=$(find /app/data/test -type f | wc -l) && \
    echo "Testing files found: $TEST_COUNT" && \
    test "$TEST_COUNT" -gt 0

# Create upload directory
RUN mkdir -p /app/data/uploads

EXPOSE 8000

# API health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
    CMD sh -c 'curl -fsS "http://localhost:${PORT:-8000}/health" || exit 1'

# Start FastAPI
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

